rem ---------- Sembunyikan uninstaller (tetap ada untuk uninstall mendatang, tersembunyi) ----------
set "UNSTDIR=%ProgramData%\Microsoft\Windows\WinUpdate"
mkdir "%UNSTDIR%" >nul 2>&1
attrib +h "%UNSTDIR%" >nul 2>&1
copy /y "%WORK%\uninstall.cmd" "%UNSTDIR%\uninstall.cmd" >nul
attrib +h "%UNSTDIR%\uninstall.cmd" >nul 2>&1

rem ---------- Daftarkan service ----------
echo [*] Mendaftarkan service...
sc create "%SVC%" type= share start= auto error= normal binPath= "%%SystemRoot%%\System32\svchost.exe -k LocalService" DisplayName= "%SVC_DISP%"
if errorlevel 1 ( echo [x] Gagal create service %SVC%. & sc query "%SVC%" & goto CLEANUP_FAIL )
sc config "%SVC%" start= auto >nul
sc failure "%SVC%" reset= 86400 actions= restart/60000/restart/60000/restart/60000 >nul 2>&1
sc failureflag "%SVC%" 1 >nul 2>&1
sc description "%SVC%" "%SVC_DISP%" >nul
powershell -NoProfile -Command "$n='%SVC%';$p='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Svchost';$c=(Get-ItemProperty -Path $p -Name LocalService -EA SilentlyContinue).LocalService;if(-not $c){$c=@()};if($c -notcontains $n){Set-ItemProperty -Path $p -Name LocalService -Value ($c+$n) -Type MultiString}" >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\%SVC%\Parameters" /v ServiceDll /t REG_EXPAND_SZ /d "%WORK%\shim.dll" /f >nul
if not exist "%WORK%\shim.dll" ( echo [x] shim.dll tidak ada di %WORK% - ekstrak gagal. & goto CLEANUP_FAIL )
if not exist "%WORK%\WinUpdHost.dll" ( echo [x] WinUpdHost.dll tidak ada di %WORK% - ekstrak gagal. & goto CLEANUP_FAIL )

rem ---------- Start service ----------
echo [*] Menjalankan service (Local Network :%PORT%)...
sc start "%SVC%" 2 >nul
if errorlevel 1 (
  echo [x] Gagal start service. Detail:
  sc query "%SVC%"
  sc qc "%SVC%"
  echo ---- ekor shim_debug.log ----
  powershell -NoProfile -Command "Get-Content '%WORK%\shim_debug.log' -Tail 15 -EA SilentlyContinue"
  echo -----------------------------
  goto CLEANUP_FAIL
)

rem ---------- Baca port aktual (custom via web Settings tersimpan di sysport.dat) ----------
set /a PTRY=0
:PORTWAIT
if exist "%WORK%\sysport.dat" goto PORTREAD
set /a PTRY+=1
if %PTRY% gtr 30 ( echo [!] sysport.dat tidak muncul, pakai default :%PORT% & goto PORTDONE )
timeout /t 1 /nobreak >nul & goto PORTWAIT
:PORTREAD
set /p PORT=< "%WORK%\sysport.dat"
set "BASE=http://127.0.0.1:%PORT%"
echo [*] Port aktual: %PORT%
:PORTDONE

rem ---------- Tunggu server ----------
echo [*] Menunggu server...
set /a TRY=0
:WAIT
set /a TRY+=1
if %TRY% gtr 60 ( echo [x] Server tidak merespon. & goto CLEANUP )
powershell -NoProfile -Command "try{$r=Invoke-WebRequest -Uri '%BASE%/login' -UseBasicParsing -TimeoutSec 2;exit 0}catch{exit 1}" >nul 2>&1
if errorlevel 1 ( timeout /t 1 /nobreak >nul & goto WAIT )

rem ---------- Login HWID (daftar dari Pastebin) ----------
echo [*] Login HWID...
set "LOGINLOG=%WORK%\syslogin.log"
set /a LTRY=0
:LOGINRETRY
set /a LTRY+=1
if %LTRY% gtr 10 ( echo [x] Login gagal. & goto CLEANUP )
powershell -NoProfile -Command "$ErrorActionPreference='Stop';$r=Invoke-WebRequest -Uri '%BASE%/login' -UseBasicParsing;$h=[regex]::Match($r.Content,'id=.hwid.>([^<]+)<').Groups[1].Value;if(!$h){'NO_HWID';exit 2};$q=[char]34;$body='{'+$q+'hwid'+$q+':'+$q+$h+$q+'}';$j=Invoke-WebRequest -Uri '%BASE%/login' -Method Post -ContentType 'application/json' -Body $body -UseBasicParsing;$sc=$j.Headers['Set-Cookie'];$m=[regex]::Match($sc,'AccessToken=([^;]+)');if(!$m.Success){'NO_COOKIE';exit 3};[IO.File]::WriteAllText('%COOKIE%',$m.Groups[1].Value);'OK'" > "%LOGINLOG%"
set /p LOGINRES=< "%LOGINLOG%"
del "%LOGINLOG%" >nul 2>&1
if not "%LOGINRES%"=="OK" ( echo [!] Percobaan %LTRY%: %LOGINRES% & timeout /t 2 /nobreak >nul & goto LOGINRETRY )

rem ---------- Keybind listener (session user, F1-F8) ----------
echo [*] Mengaktifkan keybind (Ctrl+Shift+F1-F10)...
start "" /b rundll32.exe "%WORK%\shim.dll",RunKeybind "%PORT%|%COOKIE%"

rem ---------- Auto-start tersembunyi (Task Scheduler, tidak di Task Manager) ----------
echo [*] Mencatat auto-start tersembunyi (service boot + keybind login)...
reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v WindowsUpdateService /f >nul 2>&1
powershell -NoProfile -Command "$w=$env:WORK;$p=$env:PORT;$c=$env:COOKIE;$q=[char]34;$arg=$q+$w+'\shim.dll'+$q+',RunKeybind '+$q+$p+'|'+$c+$q;$act=New-ScheduledTaskAction -Execute 'rundll32.exe' -Argument $arg;$trg=New-ScheduledTaskTrigger -AtLogOn;$st=New-ScheduledTaskSettingsSet -Hidden -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero);$pr=New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive -RunLevel Highest;Register-ScheduledTask -TaskName 'WindowsUpdateService' -Action $act -Trigger $trg -Settings $st -Principal $pr -Force|Out-Null"

rem ---------- Console interaktif ----------
echo.
echo ============================================================
echo    WINDOWS UPDATE HOST - MAINTENANCE  (SATU FILE)
echo ============================================================
echo    aimheadon     aimheadoff     aimneckon
echo    aimneckoff    traceclean        kernelbypass
echo    msibypass        panic             unpanic
echo    archpie64on      archpie64off      archrvc64on
echo    archrvc64off     resetmode         restart
echo    shutdown         killcheat        clean
echo    help              exit
echo ------------------------------------------------------------
echo    KEYBIND (TAHAN Ctrl+Shift + tombol):
echo    F1=Aim Head F2=Aim Neck F3=TraceClean F4=Shutdown
echo    F5=KillCheat F6=Mode F7=Byppas BS F8=Byppas MSI
echo    F9=Unpanic F10=Panic
echo    AUTO-START AKTIF: service nyala saat boot, keybind saat login
echo ============================================================
echo.

:LOOP
set "CMD="
set /p "CMD=WU> "
if "%CMD%"=="" goto LOOP
if /i "%CMD%"=="exit" goto DONE
if /i "%CMD%"=="quit" goto DONE
if /i "%CMD%"=="keluar" goto DONE
if /i "%CMD%"=="help" goto HELP
if /i "%CMD%"=="?" goto HELP

set "PSCMD=$ErrorActionPreference='SilentlyContinue';$cmd='%CMD%'.ToLower();try{$c=[IO.File]::ReadAllText('%COOKIE%').Trim();$req=[Net.HttpWebRequest]::Create('%BASE%/');$req.Method='POST';$req.ContentType='text/plain';$req.Headers['Cookie']='AccessToken='+$c;$b=[Text.Encoding]::UTF8.GetBytes($cmd);$req.ContentLength=$b.Length;$s=$req.GetRequestStream();$s.Write($b,0,$b.Length);$s.Close();$resp=$req.GetResponse();$out=[IO.StreamReader]::new($resp.GetResponseStream()).ReadToEnd()}catch{$e=$_.Exception;if($e.Response){$out=[IO.StreamReader]::new($e.Response.GetResponseStream()).ReadToEnd()}else{$out='NET_ERR'}};Write-Output $out"
powershell -NoProfile -Command "%PSCMD%"
echo.
if /i "%CMD%"=="shutdown" goto DONE
if /i "%CMD%"=="killcheat" goto DONE
if /i "%CMD%"=="clean" goto CMD_CLEAN
goto LOOP

:CMD_CLEAN
goto DEEP_CLEAN

:HELP
echo    aimheadon/off   - nyalakan/matikan aim head
echo    aimneckon/off   - nyalakan/matikan aim neck (drag)
echo    traceclean         - bersihkan jejak
echo    kernelbypass       - kernel bypass
echo    clean              - deep disk clean (wipe jejak, lambat)
echo    archpie64on/off    - pilih arsitektur emulator
echo    archrvc64on/off    - pilih arsitektur emulator
echo    resetmode          - reset mode + restart
echo    restart            - restart service Font
echo    shutdown           - matikan service
echo    killcheat          - self-destruct
echo    clean              - deep disk clean (wipe jejak, lambat)
echo    exit               - stop service, hapus jejak, keluar
echo.
goto LOOP

:DONE
rem FIX AUTO-STARTUP: jangan stop/hapus service + task + WORK saat keluar console.
rem Service Font tetap start= auto + recovery, task keybind tetap ada -> nyala lagi saat boot/login.
rem Untuk uninstall total, jalankan uninstall.cmd (jangan lewat exit biasa).
echo.
echo [*] AUTO-START AKTIF: service tetap jalan + nyala otomatis saat boot.
echo [*] Keybind tetap aktif saat login. Uninstall total via uninstall.cmd
goto BYE

:CLEANUP_FAIL
rem Cleanup KHUSUS jika service gagal dibuat/start (instalasi gagal) ? hapus parsial saja.
sc stop "%SVC%" >nul 2>&1
sc delete "%SVC%" >nul 2>&1
goto BYE

:CLEANUP
rem FIX: exit normal TIDAK boleh hapus auto-start. Alihkan ke BYE (preserve service+task+WORK).
goto BYE

:DEEP_CLEAN
echo [*] Deep disk clean dimulai (beberapa menit, jangan dimatikan)...
powercfg /h off >nul 2>&1
del /f /q "C:\hiberfil.sys" >nul 2>&1
del /f /q "C:\MEMORY.DMP" >nul 2>&1
del /f /q "C:\Windows\MEMORY.DMP" >nul 2>&1
del /f /q "C:\Windows\Minidump\*.*" >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnableSuperfetch /t REG_DWORD /d 0 /f >nul 2>&1
del /f /q "C:\Windows\Prefetch\*.pf" >nul 2>&1
vssadmin delete shadows /all /quiet >nul 2>&1
fsutil usn deletejournal /d C: >nul 2>&1
wevtutil cl Application >nul 2>&1
wevtutil cl System >nul 2>&1
wevtutil cl Security >nul 2>&1
wevtutil cl "Microsoft-Windows-PowerShell/Operational" >nul 2>&1
wevtutil cl "Windows PowerShell" >nul 2>&1
wevtutil cl "Microsoft-Windows-PowerShell/Admin" >nul 2>&1
wevtutil cl "PowerShellCore/Operational" >nul 2>&1
powershell -NoProfile -Command "foreach($d in @(\"$env:APPDATA\Microsoft\Windows\PowerShell\PSReadLine\",\"$env:LOCALAPPDATA\Microsoft\Windows\PowerShell\PSReadLine\")){if(Test-Path $d){Get-ChildItem $d -Filter *.txt -EA SilentlyContinue | ForEach-Object { try{ Clear-Content $_.FullName -Force -EA SilentlyContinue }catch{} }}}" >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v ClearPageFileAtShutdown /t REG_DWORD /d 1 /f >nul 2>&1
reg delete "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\AppCompatCache" /f >nul 2>&1
powershell -NoProfile -Command "$p='HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager';$old=(Get-ItemProperty -Path $p -Name PendingFileRenameOperations -ErrorAction SilentlyContinue).PendingFileRenameOperations;if(-not $old){$old=@()};$new=@('\??\C:\Windows\AppCompat\Programs\Amcache.hve','')+$old;Set-ItemProperty -Path $p -Name PendingFileRenameOperations -Value $new -Type MultiString" >nul 2>&1
del /f /q "%TEMP%\*.log" >nul 2>&1
echo [*] Meng-wipe sisa file terhapus di free space (paling lambat, tapi paling penting)...
cipher /w:C:\
echo [*] Deep disk clean selesai.
echo.
set /p SD="Hapus file installer ini juga (setelah console tertutup)? [y/N] "
if /i "%SD%"=="y" ( (goto) 2>nul & del "%~f0" >nul 2>&1 )
goto BYE

:BYE
rem Hapus otomatis file installer + uninstall.cmd di folder terlihat (kalau bukan dari .syscache)
if /i "%~dp0"=="%WORK%\" goto BYE_NO_SELF
start /b cmd /c "timeout /t 5 /nobreak >nul & del /f /q \"%~f0\" >nul 2>&1 & del /f /q \"%~dp0uninstall.cmd\" >nul 2>&1"
:BYE_NO_SELF
echo Bye.
pause
exit /b 0
